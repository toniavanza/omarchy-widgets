face "mes" {
  // The whole month with the bands of the events and, when you tap a day, its
  // agenda. month.py (embedded below) turns the secret iCal addresses of your
  // calendars into the data drawn here.
  meta {
    owl: 10
    description: "The whole month with colored event bands, and the agenda of the day you tap, from your calendars' secret iCal addresses"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  requires { pacman: ["python", "python-icalendar", "python-recurring-ical-events", "gzip"] }
  padding: 0
  background: background

  state ym = "" persist          // month shown "2026-10"; empty = the current one
  state sel = "" persist         // day tapped "2026-10-23"; empty = today
  state cals = [] persist  // [{n, u, c, on}]
  state setup = false
  state nn = ""                  // new calendar: name
  state nu = ""                  // new calendar: iCal address

  let cs = cals ?? []
  let calsJson = "[" + cs.map(c => "{\"n\":\"${c.n}\",\"u\":\"${c.u}\",\"c\":\"${c.c}\",\"on\":${c.on ? 'true' : 'false'}}").join(",") + "]"

  source now = clock every 1m
  source data = cmd("mkdir -p ~/.local/share/owlcal; echo '' | base64 -d | gunzip > ~/.local/share/owlcal/month.py; python3 ~/.local/share/owlcal/month.py ${sh(ym)} ${sh(calsJson)}") every 5m json timeout 120s
  let palette = ["#f7768e", "#7aa2f7", "#9ece6a", "#e0af68", "#bb9af7", "#7dcfff", "#ff9e64", "#c0caf5"]
  let cur = data.ym ?? ""
  let weeks = data.weeks ?? []
  let cy = num(sub(cur, 0, 4))
  let cm = num(sub(cur, 5, 7))
  let prevYm = cur == "" ? "" : (cm == 1 ? "${cy - 1}-12" : "${cy}-${pad(cm - 1, 2, '0')}")
  let nextYm = cur == "" ? "" : (cm == 12 ? "${cy + 1}-01" : "${cy}-${pad(cm + 1, 2, '0')}")
  let errs = entries(data.errors ?? {})
  let hoy = data.today ?? ""
  let day = sel == "" ? hoy : sel
  let evs = get(data.days, day, [])
  let agH = clamp(48 + len(evs) * 22, 62, 210)

  if setup {
    Column {
      fill: true
      background: background
      padding: [16, 16, 16, 12]
      gap: 8
      Text { text: "calendars"; style: title }
      Text {
        text: "Paste the secret iCal address of each calendar: Google Calendar → Settings → pick a calendar → “Secret address in iCal format”. The links stay on this phone."
        style: label
        color: muted
      }
      Column {
        gap: 6
        for c in cs {
          Row {
            gap: 8
            Text { text: "●"; fontSize: 13; color: c.c }
            Text { text: c.n; style: small; color: foreground; weight: 1; maxLines: 1 }
            Text {
              text: c.on ? "visible" : "hidden"
              style: label
              color: c.on ? accent : muted
              onTap: cals = cs.map(x => x.u == c.u ? {n: x.n, u: x.u, c: x.c, on: !x.on} : x)
            }
            Text {
              text: "✕"
              style: label
              color: red
              onTap: cals = cs.filter(x => x.u != c.u)
            }
          }
        }
        if len(cs) == 0 {
          Text { text: "no calendars yet"; style: label; color: muted }
        }
      }
      Spacer { size: 4 }
      Input { placeholder: "name (optional)"; onSubmit: nn = value; clear: true }
      Input { placeholder: "https://calendar.google.com/calendar/ical/…/basic.ics"; onSubmit: nu = value }
      Row {
        gap: 8
        Button {
          text: "add"
          onTap: {
            cals = trim(nu) == "" ? cs : cs + [{n: nn == "" ? "calendar ${len(cs) + 1}" : nn, u: trim(nu), c: palette[len(cs) % 8], on: true}]
            nn = ""
            nu = ""
          }
        }
        Button { text: "refresh"; onTap: { refresh(); setup = false } }
        Button { text: "back"; onTap: setup = false }
      }
      if len(errs) > 0 {
        Text { text: "no data: ${errs.map(e => e[0]).join(', ')}"; style: label; color: red }
      }
      Spacer { weight: 1 }
    }
  } else if len(cs) == 0 {
    Column {
      fill: true
      background: background
      padding: 24
      gap: 10
      align: center
      justify: center
      Text { text: "no calendars yet"; style: title; align: center }
      Text {
        text: "Add the secret iCal address of your Google calendars to see the month here."
        style: small
        color: muted
        align: center
      }
      Button { text: "add calendars"; onTap: setup = true }
    }
  } else {
    Column {
      fill: true
      background: background
      // ---- header: month, arrows and settings
      Row {
        gap: 2
        height: 38
        padding: [14, 6, 14, 4]
        Text { text: "‹"; fontSize: 20; color: muted; width: 26; onTap: { ym = prevYm; sel = "" } }
        Text { text: data.title ?? "…"; style: title; weight: 1 }
        Text { text: "›"; fontSize: 20; color: muted; width: 26; align: end; onTap: { ym = nextYm; sel = "" } }
        Text { text: "⚙"; fontSize: 15; color: muted; width: 26; align: end; onTap: setup = true }
      }

      // ---- weekday initials (same 7 columns as the grid)
      Row {
        height: 18
        for d in data.hdr ?? ["M", "T", "W", "T", "F", "S", "S"] {
          Text { text: d; style: label; color: muted; align: center; weight: 1 }
        }
      }

      // ---- one row per week: the drawing below, seven tap areas on top
      for w in weeks {
        Box {
          weight: 1
          Canvas {
            let cw = width / 7
            let laneH = 17
            line(0, 0, width, 0, stroke: alpha(border, 0.45), width: 1)
            for c, ci in w.cells {
              let cx = ci * cw
              if c.today {
                rect(cx + 1, 1, cw - 2, 17, radius: 8 * corners, color: accent)
              }
              text(str(c.d), cx + cw / 2, 10, size: 12, align: center,
                   color: c.today ? background : (c.in ? (c.we ? muted : foreground) : alpha(foreground, 0.35)),
                   bold: c.today)
            }
            for b in w.bands {
              let bx = b.c * cw + 1
              let bw = b.s * cw - 2
              let by = 22 + b.l * laneH
              rect(bx, by, bw, laneH - 4, radius: 3 * corners, color: b.col)
              clip(bx, by, bw, laneH - 4) {
                text(b.s == 1 && b.h != "" ? "${b.h} ${b.t}" : b.t,
                     bx + 3, by + (laneH - 4) / 2, size: 9, align: start, color: background)
              }
            }
            for c, ci in w.cells {
              let hid = get(w.hidden, c.ymd, 0)
              if hid > 0 {
                text("+${hid}", ci * cw + cw - 5, 22 + w.lanes * laneH + 6, size: 9, align: end, color: muted)
              }
            }
          }
          Row {
            fill: true
            for c in w.cells {
              Box {
                weight: 1
                fill: true
                onTap: sel = sel == c.ymd ? "" : c.ymd
              }
            }
          }
        }
      }

      // ---- agenda of the day (today by default)
      if day != "" {
        Column {
          height: agH
          gap: 3
          padding: [14, 8, 14, 8]
          background: alpha(surface, 0.6)
          Text {
            text: "${day}${day == hoy ? ' · today' : ''} · ${len(evs)} ${len(evs) == 1 ? 'event' : 'events'}"
            style: label
            color: muted
          }
          if len(evs) == 0 {
            Text { text: "nothing scheduled"; style: small; color: muted }
          }
          Column {
            scroll: true
            gap: 2
            for e in evs {
              Row {
                gap: 8
                Text { text: e.h; style: label; width: 76; color: e.col }
                Text { text: e.t; style: small; color: foreground; maxLines: 1; weight: 1 }
              }
            }
          }
        }
      }

      if len(errs) > 0 {
        Text {
          text: "warning: no data from ${errs.map(e => e[0]).join(', ')}"
          style: label
          color: red
          padding: [14, 2, 14, 6]
        }
      }
    }
  }
}
